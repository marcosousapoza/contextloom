# Non-secret application settings. Update deploy/contextloom.yml for deployment.
CONTEXTLOOM_PUBLIC_URL=http://localhost:8000
CONTEXTLOOM_ALLOWED_HOSTS=localhost,127.0.0.1
CONTEXTLOOM_CSRF_TRUSTED_ORIGINS=
CONTEXTLOOM_REGISTRATION_ENABLED=false
CONTEXTLOOM_SECURE_COOKIES=false
CONTEXTLOOM_LOG_LEVEL=INFO
CONTEXTLOOM_MCP_ALLOWED_HOSTS=localhost,localhost:*,127.0.0.1,127.0.0.1:*
CONTEXTLOOM_MCP_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*

# Supply these only to deploy/setup.sh or a secret manager; do not commit values.
CONTEXTLOOM_SECRET_KEY=
CONTEXTLOOM_DATABASE_PASSWORD=
CONTEXTLOOM_CREATE_ADMIN=0
CONTEXTLOOM_ADMIN_USERNAME=
CONTEXTLOOM_ADMIN_EMAIL=
CONTEXTLOOM_ADMIN_PASSWORD=
